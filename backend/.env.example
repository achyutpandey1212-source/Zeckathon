# Copy of root .env.example for backend standalone deployment on Render
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

ENABLE_KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_MS=600000
RENDER_EXTERNAL_URL=http://localhost:5000
KEEP_ALIVE_SECRET_TOKEN=ag_keepalive_secret_2026_zeckathon

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/arthaguard_ria?retryWrites=true&w=majority
MONGODB_DB_NAME=arthaguard_ria
MONGODB_VECTOR_INDEX_NAME=vector_index_rag_chunks

REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
CACHE_TTL_SECONDS=3600

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

AI_REQUEST_TIMEOUT_MS=7500
AI_CIRCUIT_BREAKER_COOLDOWN_MS=30000

JWT_ACCESS_SECRET=arthaguard_sebi_ria_jwt_access_secret_key_2026_zeckathon_ps04
JWT_REFRESH_SECRET=arthaguard_sebi_ria_jwt_refresh_secret_key_2026_zeckathon_ps04
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

DEFAULT_RIA_NAME=Vikramaditya Rao, CFA (SEBI Registered Investment Adviser)
DEFAULT_RIA_EMAIL=adviser@arthaguard.in
DEFAULT_RIA_PASSWORD=ArthaGuard@2026
