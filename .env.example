# ============================================================================
# ARTHAGUARD AI — SEBI RIA CO-PILOT (ZECKATHON PS 04)
# Unified Environment Configuration Template (.env.example)
# Copy this file to `.env` (in root and/or `backend/.env`) and enrich with your keys.
# NOTE: If MONGODB_URI or REDIS_URL are left empty or as placeholders, the system
# automatically runs in High-Speed Local Persistence + In-Memory Vector Mode!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SERVER & DEPLOYMENT CONFIGURATION
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://arthaguard.vercel.app

# ----------------------------------------------------------------------------
# 2. RENDER FREE-TIER 15-MIN COOLDOWN KEEP-ALIVE CONFIGURATION
# ----------------------------------------------------------------------------
# Enable periodic self-ping every 10 minutes (600,000 ms) so Render never sleeps
ENABLE_KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_MS=600000
# Set this to your live Render URL in production (Render also sets RENDER_EXTERNAL_URL automatically)
RENDER_EXTERNAL_URL=http://localhost:5000
KEEP_ALIVE_SECRET_TOKEN=ag_keepalive_secret_2026_zeckathon

# ----------------------------------------------------------------------------
# 3. DATABASE & VECTOR STORAGE (MONGODB ATLAS)
# ----------------------------------------------------------------------------
# MongoDB Atlas connection string (Supports both Document Store & Atlas Vector Search)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/arthaguard_ria?retryWrites=true&w=majority
MONGODB_DB_NAME=arthaguard_ria
MONGODB_VECTOR_INDEX_NAME=vector_index_rag_chunks

# ----------------------------------------------------------------------------
# 4. CACHING & RATE LIMITING (REDIS / UPSTASH REDIS)
# ----------------------------------------------------------------------------
# Optional Upstash / Redis Cloud URL for distributed caching & multi-user rate limiting
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
CACHE_TTL_SECONDS=3600

# ----------------------------------------------------------------------------
# 5. SINGLE-PROVIDER AI GATEWAY (GEMINI PRIMARY + GROQ FALLBACK)
# ----------------------------------------------------------------------------
# Primary AI Provider: Google Gemini (gemini-2.5-flash / text-embedding-004)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Fallback AI Provider: Groq Cloud (llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# AI Gateway Circuit Breaker & Timeout Settings
AI_REQUEST_TIMEOUT_MS=7500
AI_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# ----------------------------------------------------------------------------
# 6. AUTHENTICATION, JWT & SEBI RIA FIDUCIARY SECURITY
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=arthaguard_sebi_ria_jwt_access_secret_key_2026_zeckathon_ps04
JWT_REFRESH_SECRET=arthaguard_sebi_ria_jwt_refresh_secret_key_2026_zeckathon_ps04
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Default Demo SEBI RIA Adviser Credentials (for 1-click Judge evaluation)
DEFAULT_RIA_NAME=Vikramaditya Rao, CFA (SEBI Registered Investment Adviser)
DEFAULT_RIA_EMAIL=adviser@arthaguard.in
DEFAULT_RIA_PASSWORD=ArthaGuard@2026
DEFAULT_SEBI_REG_NO=INA000018492
DEFAULT_RIA_FIRM=ArthaGuard Fiduciary Advisory LLP

# ----------------------------------------------------------------------------
# 7. FRONTEND BUILD VARIABLES (VITE)
# ----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=ArthaGuard AI — SEBI RIA Co-Pilot
VITE_SEBI_REG_NO=INA000018492
